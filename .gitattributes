# Normalise line endings: LF in the repository, native in the working tree.
# Without this, checkouts on Windows and macOS/Linux produce spurious
# whole-file diffs for every source file.
* text=auto eol=lf

# Explicitly text
*.ts     text eol=lf
*.tsx    text eol=lf
*.css    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.mjs    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf

# Binary — never diff or convert
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.avif   binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.pdf    binary

# Generated: collapse in diffs and mark as non-authored on GitHub
package-lock.json  -diff linguist-generated=true
